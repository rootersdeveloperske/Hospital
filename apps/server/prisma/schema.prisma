// Prisma schema for Hospital Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  role           Role
  cnic           String?
  specialization String?
  qualification  String?
  fee            Float?
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  age       Int
  cnic      String
  tokenNo   Int      @unique
  status    String
  createdAt DateTime @default(now())
}

model Consultation {
  id           String   @id @default(cuid())
  patientId    String
  doctorId     String
  notes        String
  followUpDate DateTime?
  status       String
  createdAt    DateTime @default(now())
}

model Prescription {
  id             String @id @default(cuid())
  consultationId String
  medicineId     String
  quantity       Int
  dosage         String
}

model Medicine {
  id          String   @id @default(cuid())
  name        String
  genericName String?
  brandName   String?
  strength    String?
  dosageForm  String
  category    String?
  requiresRx  Boolean  @default(false)
  baseUnit    String
  stock       Int      @default(0)
  price       Float
  expiryDate  DateTime?
  status      String   @default("ACTIVE")
}

model Sale {
  id          String   @id @default(cuid())
  tokenNo     Int
  totalAmount Float
  createdAt   DateTime @default(now())
}

enum Role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  PHARMACIST
}
